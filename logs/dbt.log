),

final as (
    select 
        customer.customer_key,
        customer.name,
        customer.address,
        --- Break the contract 
        -- nation.nation_key as nation_key, 
        nation.name as nation,
        --- Break the contract again
        -- region.region_key as region_key,
        region.name as region,
        customer.phone_number,
